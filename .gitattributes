# Deployment files run on Linux: always check them out with LF line endings,
# whatever the editor or core.autocrlf (a CRLF shebang fails to run).
*.sh        text eol=lf
*.py        text eol=lf
*.service   text eol=lf
*.conf      text eol=lf
*.example   text eol=lf
deploy/nas-manager-cli text eol=lf
