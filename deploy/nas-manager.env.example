# Production configuration for the systemd service.
# Install as /etc/nas-manager/nas-manager.env (root:nas-manager, mode 0640).
# Contains no real secrets.
#
# NAS_DATA_DIR and NAS_LOG_DIR are deliberately NOT set here: the unit file sets
# them to /var/lib/nas-manager and /var/log/nas-manager, and systemd lets
# EnvironmentFile= override Environment=, so setting them here could point the
# sandboxed service at a read-only path.

NAS_HOST=127.0.0.1
NAS_PORT=8080

NAS_LOG_LEVEL=INFO
NAS_LOG_FORMAT=json
NAS_LOG_TO_CONSOLE=true
NAS_LOG_TO_FILE=true
NAS_LOG_MAX_BYTES=10485760
NAS_LOG_BACKUP_COUNT=5

# Migrations run in the unit's ExecStartPre, so automatic migration stays off.
NAS_AUTO_MIGRATE=false

# Terminate TLS in a reverse proxy in front of the service and mark the
# session/CSRF cookies Secure. Keep false only when traffic never leaves
# loopback (SSH tunnel). See docs/INSTALLATION.md.
NAS_SESSION_COOKIE_SECURE=true

# --- File manager ----------------------------------------------------------
# Absolute directories the file manager may access (the "jail"). JSON list.
# When empty, the default root <DATA_DIR>/files is used.
# NAS_FILE_ROOTS=["/mnt/storage"]
# Per-file upload cap in bytes (default 2 GiB, min 1 MiB).
# NAS_MAX_UPLOAD_BYTES=2147483648
# NAS_FILE_SEARCH_LIMIT=200

# --- Public upload folder ---------------------------------------------------
# Where the public drop folder lives (default <DATA_DIR>/uploads). It is
# auto-created and owned by the service user.
# NAS_PUBLIC_UPLOAD_DIR=/var/lib/nas-manager/uploads
# Master switch: when false the drop endpoints reject uploads with 403. The
# admin Settings page can override this at runtime (stored in the database).
# NAS_PUBLIC_UPLOAD_ENABLED=true
# Per-file cap for public uploads (default 1 GiB).
# NAS_PUBLIC_UPLOAD_MAX_FILE_BYTES=1073741824
# Default per-uploader quota when an admin has not set a specific one
# (default 1 GiB). A zero-sized quota row blocks new uploads for that
# uploader without touching its existing files.
# NAS_PUBLIC_UPLOAD_DEFAULT_QUOTA_BYTES=1073741824

# --- API tokens and mobile clients ------------------------------------------
# Personal scoped API tokens (Authorization: Bearer nas_...). Maximum tokens
# per user, default and maximum lifetime in days (max 0 = never-expiring
# tokens are allowed) and the default public-upload quota for each token
# (uploader key token:<id>).
# NAS_API_TOKEN_MAX_PER_USER=20
# NAS_API_TOKEN_DEFAULT_LIFETIME_DAYS=90
# NAS_API_TOKEN_MAX_LIFETIME_DAYS=365
# NAS_API_TOKEN_UPLOAD_QUOTA_BYTES=1073741824
# Failed bearer lookups per client IP within the window before 429.
# NAS_API_TOKEN_AUTH_MAX_FAILURES=20
# NAS_API_TOKEN_AUTH_WINDOW_SECONDS=300
# Resumable uploads: idle lifetime of an upload session, the largest single
# chunk and how many uploads one user may have open at once.
# NAS_RESUMABLE_UPLOAD_TTL_HOURS=24
# NAS_RESUMABLE_CHUNK_MAX_BYTES=67108864
# NAS_RESUMABLE_MAX_OPEN_PER_USER=10
# How long the sync change journal is kept; older cursors get reset=true.
# NAS_SYNC_CHANGE_RETENTION_DAYS=30

# --- Remote and cloud sync (Phase 7) ----------------------------------------
# Remote credentials (passwords, SSH keys, S3 secrets, OAuth refresh tokens)
# are encrypted with a Fernet key created on first use (mode 0600). Back the
# key up together with the database: without it every stored remote
# credential must be re-entered. Default: <DATA_DIR>/secrets/credentials.key.
# NAS_CREDENTIALS_KEY_FILE=/var/lib/nas-manager/secrets/credentials.key
# External URL of this application, only needed for the Google Drive OAuth
# redirect (<URL>/api/v1/remotes/oauth/callback must be registered with the
# Google OAuth client).
# NAS_PUBLIC_BASE_URL=https://nas.example.org
# Network timeout for every remote operation, and the browse listing cap.
# NAS_REMOTE_CONNECT_TIMEOUT_SECONDS=20
# NAS_REMOTE_BROWSE_LIMIT=500
# Sync worker (python -m app.worker): poll interval, parallel jobs, lease.
# NAS_REMOTE_SYNC_POLL_SECONDS=15
# NAS_WORKER_CONCURRENCY=1
# NAS_REMOTE_SYNC_LEASE_SECONDS=300
# Deletion guard: a run that would archive more than this many files, or
# more than this percentage of the files it last synced (when above 5),
# fails before touching anything.
# NAS_REMOTE_SYNC_MAX_DELETE_COUNT=500
# NAS_REMOTE_SYNC_MAX_DELETE_PERCENT=10
# Run history retention and the planned-action list kept per run.
# NAS_REMOTE_SYNC_RUN_RETENTION_DAYS=90
# NAS_REMOTE_SYNC_PREVIEW_LIMIT=1000

# --- Photo gallery and media libraries (Phase 8) ----------------------------
# Personal libraries live in <NAS_MEDIA_DIR>/<username> (user data: back it
# up). Thumbnails, posters and transcodes go to NAS_MEDIA_CACHE_DIR
# (disposable). Defaults: <DATA_DIR>/media and <DATA_DIR>/media-cache.
# NAS_MEDIA_DIR=/var/lib/nas-manager/media
# NAS_MEDIA_CACHE_DIR=/var/lib/nas-manager/media-cache
# Images whose header declares more pixels than this are never decoded.
# NAS_MEDIA_MAX_IMAGE_PIXELS=100000000
# The worker rescans every library this often (0 = only on request).
# NAS_MEDIA_SCAN_INTERVAL_MINUTES=60
# Thumbnails rendered per worker tick, gallery page size cap, scan lease.
# NAS_MEDIA_THUMBNAIL_BATCH=50
# NAS_MEDIA_SEARCH_LIMIT=500
# NAS_MEDIA_SCAN_LEASE_SECONDS=600

# --- Video playback and streaming (Phase 9) ---------------------------------
# ffprobe/ffmpeg (apt install ffmpeg). Found on PATH unless set here; without
# them videos are indexed and downloadable but have no metadata, posters or
# transcodes.
# NAS_FFMPEG_PATH=/usr/bin/ffmpeg
# NAS_FFPROBE_PATH=/usr/bin/ffprobe
# NAS_MEDIA_PROBE_TIMEOUT_SECONDS=30
# Videos a browser cannot play directly are converted (by the worker, one at
# a time) to a cached H.264/AAC MP4. Disable to serve compatible videos only.
# NAS_MEDIA_TRANSCODE_ENABLED=true
# NAS_MEDIA_TRANSCODE_MAX_HEIGHT=1080
# NAS_MEDIA_TRANSCODE_CRF=23
# One of ultrafast, superfast, veryfast, faster, fast, medium, slow.
# NAS_MEDIA_TRANSCODE_PRESET=veryfast
# ffmpeg threads per transcode (0 = ffmpeg decides).
# NAS_MEDIA_TRANSCODE_THREADS=2
# NAS_MEDIA_TRANSCODE_TIMEOUT_SECONDS=21600
# Least recently streamed transcodes are evicted above this size (bytes).
# NAS_MEDIA_TRANSCODE_CACHE_MAX_BYTES=21474836480
# NAS_MEDIA_TRANSCODE_LEASE_SECONDS=600

# --- Samba -----------------------------------------------------------------
# Where smb.conf is rendered and validated. The web process is unprivileged
# and cannot write /etc/samba/smb.conf; the privileged helper (Phase 5) writes
# it and reloads smbd. Leave NAS_SAMBA_CONFIG_PATH unset (default:
# /etc/samba/smb.conf) so Apply delegates the write+reload to the helper.
# NAS_SAMBA_CONFIG_PATH=/etc/samba/smb.conf
# NAS_SAMBA_BACKUP_DIR=/var/lib/nas-manager/samba-backups

# --- Privileged helper (Phase 5) -------------------------------------------
# Separate root-haver that performs disk/storage/RAID actions and the Samba
# write+reload over a Unix socket. This flag makes the web process use it.
# The unit file also sets NAS_HELPER_SOCKET to /run/nas-manager/helper.sock
# and NAS_HELPER_ENABLED=true for the helper's own process.
NAS_HELPER_ENABLED=true
# NAS_HELPER_SOCKET=/run/nas-manager/helper.sock
# How long the web process waits for one helper request.
# NAS_HELPER_TIMEOUT_SECONDS=10
# Comma-separated numeric UIDs allowed to call the helper (root is always
# allowed). Set the NAS Manager service account's UID here; the helper also
# verifies every peer with SO_PEERCRED.
# NAS_HELPER_ALLOWED_UIDS=0
# Samba config named group that may connect through the helper socket.
# NAS_HELPER_SOCKET_GROUP=nas-manager
