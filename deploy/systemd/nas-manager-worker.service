[Unit]
Description=NAS Manager sync worker (remote and cloud synchronization)
Documentation=file:///opt/nas-manager/docs/INSTALLATION.md
# The web unit applies schema migrations in its ExecStartPre; the worker
# refuses to start while the schema is behind, so order it after the web unit.
After=network-online.target nas-manager.service
Wants=network-online.target

[Service]
Type=simple
User=nas-manager
Group=nas-manager
WorkingDirectory=/opt/nas-manager
EnvironmentFile=/etc/nas-manager/nas-manager.env
Environment=NAS_DATA_DIR=/var/lib/nas-manager
Environment=NAS_LOG_DIR=/var/log/nas-manager
Environment=NAS_ENVIRONMENT=production
# The worker writes its own log file next to the web application's.
Environment=NAS_LOG_FILE_NAME=worker.log

ExecStart=/opt/nas-manager/.venv/bin/python -m app.worker

Restart=on-failure
RestartSec=10
# SIGTERM asks running jobs to stop after their current file; give a large
# transfer time to finish before systemd kills the process. An interrupted
# run is reclaimed (marked failed) and the next run resumes from the
# per-file sync records.
TimeoutStopSec=300

StateDirectory=nas-manager
StateDirectoryMode=0750
LogsDirectory=nas-manager
LogsDirectoryMode=0750
UMask=0027

# The worker also scans media libraries, renders thumbnails and runs ffmpeg
# transcodes (Phases 8-9). Run it at a lower CPU and I/O priority than the
# web unit so a long transcode never makes the UI or Samba sluggish; ffmpeg
# inherits these (it cannot lower its own priority under ~@resources).
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7

# Same sandbox as the web unit. Managed file roots, NAS_MEDIA_DIR and
# NAS_MEDIA_CACHE_DIR outside /var/lib/nas-manager must be listed here too, e.g.:
# ReadWritePaths=/srv/nas /srv/media
NoNewPrivileges=true
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
RestrictSUIDSGID=true
RestrictRealtime=true
RestrictNamespaces=true
LockPersonality=true
MemoryDenyWriteExecute=true
SystemCallArchitectures=native
# AF_UNIX is also what the monitor (Phase 10) needs: `systemctl show` talks to
# systemd over the D-Bus system socket, and SMART reads go through the helper
# socket. Monitoring reads /proc/mdstat and the process table; do not add
# ProtectProc=invisible or ProcSubset=pid unless you accept losing the process
# list and RAID checks.
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources

[Install]
WantedBy=multi-user.target
