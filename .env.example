# NAS Manager configuration. Copy to .env (development) or to
# /etc/nas-manager/nas-manager.env (systemd). Contains no real secrets.
# Every variable uses the NAS_ prefix.

# development | production | test
NAS_ENVIRONMENT=production
NAS_DEBUG=false

NAS_HOST=127.0.0.1
NAS_PORT=8080

# Application state (SQLite database, logs). Relative paths resolve against the
# working directory; systemd deployments use /var/lib/nas-manager.
NAS_DATA_DIR=data

# Optional overrides. Defaults: sqlite:///<DATA_DIR>/nas.db and <DATA_DIR>/logs
# NAS_DATABASE_URL=sqlite:////var/lib/nas-manager/nas.db
# NAS_LOG_DIR=/var/log/nas-manager

# DEBUG | INFO | WARNING | ERROR | CRITICAL
NAS_LOG_LEVEL=INFO
# json | text
NAS_LOG_FORMAT=json
NAS_LOG_TO_CONSOLE=true
NAS_LOG_TO_FILE=true
NAS_LOG_MAX_BYTES=10485760
NAS_LOG_BACKUP_COUNT=5

# Apply Alembic migrations automatically at startup (default: false).
NAS_AUTO_MIGRATE=false

# --- Sessions and CSRF -----------------------------------------------------
# Cookie name for the server-side session and the CSRF double-submit token.
# NAS_SESSION_COOKIE_NAME=nas_session
# NAS_CSRF_COOKIE_NAME=nas_csrf
# Mark the session/CSRF cookies Secure. Set true when TLS terminates in front
# of the application (recommended; see docs/INSTALLATION.md). Default false so
# loopback development over plain http keeps working.
NAS_SESSION_COOKIE_SECURE=false
# lax | strict | none  (none additionally requires secure=true)
# NAS_SESSION_COOKIE_SAMESITE=lax
# Session validity (seconds): hard TTL and absolute idle ceiling.
# NAS_SESSION_TTL_SECONDS=43200
# NAS_SESSION_IDLE_MAX_SECONDS=604800
# NAS_CSRF_MAX_AGE_SECONDS=43200

# --- Login throttling ------------------------------------------------------
# Per-account lockout after N consecutive failures; per-IP sliding window.
# NAS_LOGIN_LOCKOUT_THRESHOLD=5
# NAS_LOGIN_LOCKOUT_MINUTES=15
# NAS_LOGIN_IP_MAX_ATTEMPTS=20
# NAS_LOGIN_IP_WINDOW_SECONDS=300

# --- Password policy and Argon2id -----------------------------------------
# NAS_PASSWORD_MIN_LENGTH=12
# NAS_PASSWORD_MAX_LENGTH=128
# NAS_ARGON2_TIME_COST=3
# NAS_ARGON2_MEMORY_COST=65536
# NAS_ARGON2_PARALLELISM=4

# Username used by `python -m app.cli bootstrap-admin` when --username is omitted.
# NAS_ADMIN_USERNAME=admin
